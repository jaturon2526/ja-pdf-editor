# =============================================================================
# backend/.env — ค่าตั้งค่าของ backend (คัดลอกไฟล์นี้เป็น backend/.env แล้วแก้ค่า)
#   cp backend/.env.template backend/.env
# ใช้กับ docker-compose.dev.yml และ docker-compose.yml (ฝั่ง production ใช้ .env.prod — ดู .env.prod.template)
# รูปแบบ: 1 ค่าต่อ 1 บรรทัด KEY=value ห้ามมีช่องว่างรอบ = และต้องขึ้นบรรทัดใหม่ทุกครั้ง
# (ถ้าสองบรรทัดติดกัน ระบบจะอ่านเป็นค่าเดียว — backend จะเตือนใน log ถ้า FRONTEND_URL ผิดรูปแบบ)
# บรรทัดที่ขึ้นต้นด้วย # คือค่าที่ไม่บังคับ (ใช้ค่าเริ่มต้นที่เขียนไว้) — ลบ # ออกเมื่อต้องการเปลี่ยน
# =============================================================================

# ---------- ความปลอดภัย (จำเป็น) ----------
# คีย์เซ็น JWT ยาว >= 32 ตัว สร้างด้วย: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# ไม่ตั้ง: dev จะสุ่มค่าใหม่ทุกครั้งที่ start (ผู้ใช้หลุด login ทุกครั้งที่ restart) · APP_ENV=production จะไม่ยอม start
# ⚠ ใช้เข้ารหัส API key Gemini ที่ผู้ใช้บันทึกไว้ด้วย — เปลี่ยนค่าแล้ว: ทุกคนหลุด login, ลิงก์ในอีเมลที่ส่งไปแล้วใช้ไม่ได้
#   และ API key ที่ผู้ใช้บันทึกไว้ต้องใส่ใหม่ (ถอดรหัสไม่ได้) — ตั้งครั้งเดียวแล้วเก็บไว้ อย่าเปลี่ยน
JWT_SECRET=
# APP_ENV=production
# อายุการเข้าสู่ระบบ (นาที) ค่าเริ่มต้น 7 วัน
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ผู้ดูแลระบบอัตโนมัติ: อีเมลที่สมัคร/เข้าสู่ระบบครั้งแรกแล้วได้สิทธิ์ผู้ดูแล (คั่นด้วย ,)
# ไม่ตั้ง = ผู้ที่สมัครคนแรกของระบบได้สิทธิ์ (ฐานข้อมูลใหม่ที่เปิดสาธารณะ คนนอกอาจสมัครก่อน)
# ตั้งผู้ดูแลภายหลัง: docker compose exec backend python -m scripts.make_admin <email>
# INITIAL_ADMIN_EMAILS=you@example.com

# ---------- URL ของหน้าเว็บ (จำเป็น) ----------
# ใช้สร้างลิงก์ในอีเมล (ยืนยันอีเมล / ตั้งรหัสผ่านใหม่ / แจ้งเตือนการลงนาม) — ต้องเป็น URL ที่ผู้ใช้เปิดได้จริง
# docker compose ในเครื่อง: http://localhost:8080 · เซิร์ฟเวอร์จริง: https://your-domain.com (ไม่มี / ปิดท้าย)
FRONTEND_URL=http://localhost:8080

# ---------- รูปแบบการติดตั้ง ----------
# DEPLOYMENT_PROFILE=public            # public (ค่าเริ่มต้น) | onprem — onprem ปิด Google/LINE เป็นค่าเริ่มต้น (ดู .env.onprem.template)
# AUTH_GOOGLE_ENABLED=true             # ค่าเริ่มต้น: public=true, onprem=false (ยังต้องตั้ง GOOGLE_CLIENT_ID)
# AUTH_LINE_ENABLED=true               # ค่าเริ่มต้น: public=true, onprem=false (ยังต้องตั้ง LINE_*)
# ALLOW_SELF_REGISTRATION=true         # false = สมัครได้เฉพาะ INITIAL_ADMIN_EMAILS และผู้ได้รับเชิญลงนาม
# ALLOWED_EMAIL_DOMAINS=               # จำกัดโดเมนอีเมลของบัญชีใหม่ เช่น company.co.th,company.com — ว่าง = ทุกโดเมน

# ---------- อีเมล (SMTP) ----------
# ไม่ตั้ง SMTP_USERNAME/SMTP_PASSWORD = ไม่ส่งอีเมลจริง แต่พิมพ์เนื้อหาอีเมลลง log แทน ([EMAIL SIMULATION])
# Gmail: เปิด 2-Step Verification แล้วสร้าง App Password 16 ตัว (ไม่ใช่รหัสผ่าน Gmail ปกติ) · รองรับ STARTTLS พอร์ต 587
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM=no-reply@your-domain.com   # ที่อยู่ผู้ส่ง (ค่าเริ่มต้น = SMTP_USERNAME)
#   ใช้ Gmail: เว้นว่าง หรือใส่อีเมลเดียวกับ SMTP_USERNAME — โดเมนอื่นต้องตั้ง DKIM ของโดเมนนั้นด้วย ไม่งั้นอาจถูกตีกลับ (550 5.7.30)
# SMTP_USE_TLS=true                   # STARTTLS (พอร์ต 587) — พอร์ต 465 ใช้ SSL ตั้งแต่ต้นให้อัตโนมัติ
# SMTP_SECURITY=starttls               # starttls | ssl | none (relay ภายใน) — ว่าง = เลือกจากค่าข้างบน
# SMTP_AUTH=true                       # ว่าง = login เมื่อตั้ง SMTP_USERNAME · false = relay ไม่ต้อง login (ต้องตั้ง SMTP_FROM)
# SMTP_CA_FILE=/run/secrets/pdf-editor/org-ca.pem   # CA ขององค์กรสำหรับตรวจใบรับรอง mail server ภายใน
# APP_NAME=JA PDF Editor               # ชื่อระบบในอีเมล เช่น "สมชาย ผ่าน JA PDF Editor"
# ลิงก์ซอร์สโค้ดที่แสดงในหน้าเว็บ (AGPL-3.0) — ไม่แก้โค้ด: ไม่ต้องตั้ง · แก้โค้ดแล้วเปิดให้คนอื่นใช้: ชี้ไปที่ซอร์สฉบับที่แก้
# SOURCE_CODE_URL=https://github.com/jaturon2526/ja-pdf-editor

# ---------- เข้าสู่ระบบด้วย Google (ไม่บังคับ) ----------
# OAuth 2.0 Client ID จาก Google Cloud Console — ตั้งแล้วปุ่ม Google แสดงเอง (หน้าเว็บอ่านจาก /api/config/public)
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com

# ---------- AI (Gemini) (ไม่บังคับ) ----------
# API Key ส่วนกลางของระบบ จาก Google AI Studio — ใช้แปลง PDF เป็น Word แบบ AI และ OCR
# GEMINI_API_KEY=AIza...
# ผู้ให้บริการ AI: gemini (ค่าเริ่มต้น) | anthropic (Claude) | openai (OpenAI / Azure OpenAI / vLLM / Ollama / LiteLLM)
#   Claude ต้องใช้ API key จาก Claude Console (console.anthropic.com — คิดเงินตามการใช้) แผนสมาชิก Claude Pro/Max/Team ใช้แทนไม่ได้
# AI_PROVIDER=anthropic
# AI_API_KEY='sk-ant-...'                # gemini ใช้ GEMINI_API_KEY เดิมได้
# AI_MODEL=                               # ว่าง = รุ่นเร็วของค่าย (gemini: Flash ล่าสุด, anthropic: claude-haiku-5-5) · openai ต้องระบุ
# AI_BASE_URL=                            # openai: URL ของ API เช่น https://<resource>.openai.azure.com/openai/v1 หรือ http://llm.local:8000/v1
# AI_USER_KEYS_ENABLED=true               # ผู้ใช้ใส่ API key ของตัวเอง (เลือกค่ายเอง เช่น เครดิตแผนก) — false = ใช้ AI ของระบบอย่างเดียว
# AI_PRIVATE_HOSTS=                       # โฮสต์ภายในที่ผู้ใช้ตั้งเป็น URL ของ API ได้ (คั่นด้วย ,) — ปกติห้ามชี้เข้าเครือข่ายภายใน
# AI_SYSTEM_DAILY_LIMIT=2              # โควต้าใช้ AI ส่วนกลางต่อผู้ใช้ต่อวัน

# ---------- การลงนามเอกสาร (ไม่บังคับ) ----------
# SIGNING_DUE_SOON_HOURS=24            # เตือนผู้ลงนามเมื่อเหลือเวลาก่อนครบกำหนดเท่านี้ (ชั่วโมง)
# SIGNING_REMIND_COOLDOWN_MINUTES=60   # ผู้ส่งกด "ส่งเตือน" ซ้ำได้หลังผ่านไปกี่นาที
# SIGNING_CHECK_INTERVAL_MINUTES=10    # ตรวจวันครบกำหนดทุกกี่นาที
# ใบรับรองระบบจาก CA แทน self-signed: วางไฟล์ไว้ที่ backend/secrets/seal.p12 (ไม่เข้า git)
# ใส่ path "ภายใน container" เท่านั้น ไม่ใช่ path บนเครื่อง เช่น /Users/...
# SIGNING_SEAL_P12=/run/secrets/pdf-editor/seal.p12
# SIGNING_SEAL_P12_PASSWORD=รหัสผ่านไฟล์_p12
# SIGNING_FETCH_CHAIN=true             # ดาวน์โหลด chain ของใบรับรองจาก URL ในใบรับรอง เมื่อ .p12 ไม่ได้รวมมา
# SIGNING_FETCH_CHAIN_TIMEOUT=5
# ประทับเวลาลายเซ็นโดย TSA (RFC 3161) — ว่าง = ไม่ใช้ · ถ้า TSA ล่ม ระบบลงนามต่อโดยไม่มี timestamp
# SIGNING_TSA_URL=http://timestamp.sectigo.com     # ใช้บน production อยู่ (Sectigo — ฟรี ไม่ต้องสมัคร)
# SIGNING_TSA_URL=http://timestamp.digicert.com    # ทางเลือก (DigiCert)
# SIGNING_TSA_TIMEOUT=10

# ---------- แจ้งเตือนการลงนามทาง LINE (ไม่บังคับ — ไม่ตั้ง = ปิดฟีเจอร์ ส่วน LINE ในหน้าเว็บจะซ่อน) ----------
# ค่าจาก LINE Developers Console › provider › channel (Messaging API)
#   Channel secret: แท็บ Basic settings · Channel access token (long-lived): แท็บ Messaging API › Issue
# เครื่อง dev: ปกติไม่ต้องตั้ง — LINE ส่ง webhook ได้เฉพาะ URL https สาธารณะ (channel เดียวตั้ง Webhook URL ได้ที่เดียว
#   ถ้าใช้ channel เดียวกับเซิร์ฟเวอร์จริง อย่าเปลี่ยน Webhook URL ไปที่เครื่อง dev) · ห้ามใส่ค่าจริงใน git
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_OA_BASIC_ID=@xxxxxxxx           # Basic ID ของ OA (มี @) ใช้สร้างลิงก์/QR เปิดแชทพร้อมรหัสเชื่อมต่อ
# LINE_MONTHLY_LIMIT=280               # เพดานข้อความ push ต่อเดือน (แพ็กเกจฟรี 300) ครบแล้วส่งอีเมลแทน
# LINE_API_BASE=https://api.line.me    # ใช้ในเทสต์เท่านั้น (ชี้ไป LINE API จำลอง)

# ---------- เข้าสู่ระบบด้วย LINE (ไม่บังคับ — ไม่ตั้ง = ซ่อนปุ่ม) ----------
# LINE Developers Console › LINE Login channel (provider เดียวกับ OA) › Basic settings
# Callback URL ต้องตรงกับ FRONTEND_URL + /auth/line/callback (เช่น http://localhost:5173/auth/line/callback — เพิ่มได้หลายบรรทัด)
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=

# ---------- หน้าโควต้า/เครดิตของแอดมิน (ไม่บังคับ) ----------
# BREVO_API_KEY=                       # Brevo API key แบบ Restricted (Transactional email + Account = Read) — ไม่ตั้ง = นับเอง
# BREVO_DAILY_LIMIT=300
# AI_DAILY_REQUEST_LIMIT=0             # (เดิม GEMINI_DAILY_REQUEST_LIMIT) 0 = ไม่ทราบเพดาน
# QUOTA_ALERT_PERCENT=80               # แจ้งแอดมินเมื่อใช้เกิน % นี้ (วันละไม่เกิน 1 ครั้งต่อบริการ)
# QUOTA_CHECK_INTERVAL_MINUTES=60

# ---------- ไฟล์และ session (ไม่บังคับ) ----------
# PDF_MAX_UPLOAD_SIZE=52428800         # ขนาดไฟล์สูงสุด (byte) — ถ้าเพิ่ม ต้องเพิ่ม client_max_body_size ใน frontend/nginx.conf ด้วย
# PDF_MAX_MERGE_TOTAL=157286400        # รวมไฟล์ PDF: ขนาดรวมของไฟล์จากเครื่อง (byte) — ส่งในคำขอเดียว จึงถูก nginx
#                                      #   จำกัดที่ client_max_body_size (60M) ก่อน · ไฟล์จากเอกสารของฉันไม่นับ
# PDF_SESSION_TTL_MINUTES=1440         # เคลียร์ไฟล์ที่เปิดค้างไว้หลังไม่ได้ใช้กี่นาที
# PDF_CLEANUP_INTERVAL_MINUTES=60
# PDF_ALLOWED_ORIGINS=http://localhost:8080   # CORS (คั่นด้วย ,) — ปกติไม่ต้องตั้ง หน้าเว็บเรียก API ผ่าน nginx
# WEBAUTHN_RP_ID=localhost             # Passkey — ปกติไม่ต้องตั้ง (ใช้โดเมนของ FRONTEND_URL)
# WEBAUTHN_ORIGINS=http://localhost:8080
# WEBAUTHN_RP_NAME=JA PDF Editor       # ชื่อที่แสดงในหน้าต่างสร้าง passkey ของเครื่อง
# FONT_URL_ALLOWED_HOSTS=fonts.google.com,fonts.googleapis.com   # โดเมนที่ "ติดตั้งฟอนต์จากลิงก์" รับ (https เท่านั้น)
# APP_TIMEZONE=Asia/Bangkok            # เขตเวลาในอีเมลและหนังสือรับรอง (docker compose ตั้งให้แล้ว)

# ---------- ตั้งไว้ใน docker compose แล้ว ไม่ต้องใส่ที่นี่ ----------
# DATABASE_URL, PDF_REDIS_URL, PDF_UPLOAD_DIR, PDF_WORKING_DIR, TZ
