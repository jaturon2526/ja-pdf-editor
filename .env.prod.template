# =============================================================================
# .env.prod — ค่าตั้งค่าสำหรับ docker-compose.prod.yml (เซิร์ฟเวอร์จริง ใช้ image จาก Docker Hub)
#   cp .env.prod.template .env.prod      แล้วแก้ค่าที่มี <...>
# รันด้วย --env-file เสมอ (ค่า DB_* ใช้แทนตัวแปรใน compose ด้วย ไม่ใช่แค่ส่งเข้า container):
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# ห้าม commit ไฟล์ .env.prod (อยู่ใน .gitignore แล้ว)
#
# ครั้งแรก: backend สร้างตารางในฐานข้อมูลทั้งหมดเองตอน start (Alembic) และอัปเกรด schema เองทุกครั้งที่ deploy
# สำรองข้อมูล = ฐานข้อมูล (volume pgdata_prod) + ไฟล์ผู้ใช้ (volume pdf_data_prod) + .env.prod + ./secrets — ต้องครบทั้ง 4
# ย้ายเซิร์ฟเวอร์: กู้ฐานข้อมูล (pg_restore) และไฟล์ใน /data "ก่อน" start backend ครั้งแรก, ใช้ JWT_SECRET และโดเมนเดิม
#   (start backend บนฐานข้อมูลว่างก่อน จะสร้างตารางเปล่า แล้วกู้ dump ทับจะชนกัน — ใช้ pg_restore --clean)
# =============================================================================

# ---------- รูปแบบการติดตั้ง ----------
# public = เว็บสาธารณะ (ค่าเริ่มต้น) · ติดตั้งในองค์กรใช้ .env.onprem.template แทนไฟล์นี้
# DEPLOYMENT_PROFILE=public
# ALLOWED_EMAIL_DOMAINS=                  # จำกัดโดเมนอีเมลของบัญชีใหม่ (คั่นด้วย ,) — ว่าง = ทุกโดเมน
# ALLOW_SELF_REGISTRATION=true            # false = ปิดปุ่มสมัครสมาชิก (สมัครได้เฉพาะ INITIAL_ADMIN_EMAILS และผู้ได้รับเชิญลงนาม)

# image ที่ใช้ (ไม่ตั้ง = docker.io/jaturon2526/pdf-editor-*:latest — scripts/ship.sh push แท็กนี้)
# IMAGE_TAG=latest
# BACKEND_IMAGE=docker.io/jaturon2526/pdf-editor-backend
# FRONTEND_IMAGE=docker.io/jaturon2526/pdf-editor-frontend

# ---------- ฐานข้อมูล (จำเป็น) ----------
DB_USER=pdf_user
# ⚠ postgres ตั้งรหัสผ่านจากค่านี้ "ครั้งแรกที่สร้าง volume" เท่านั้น — แก้ทีหลังต้องเปลี่ยนในฐานข้อมูลด้วย
#   (ALTER USER pdf_user PASSWORD '...') ไม่งั้น backend ต่อฐานข้อมูลไม่ได้
DB_PASSWORD=<รหัสผ่านฐานข้อมูลที่เดายาก>
DB_NAME=pdf_editor
# REDIS_MAXMEMORY=1536mb
# จำนวน process ของ backend — ใช้ CPU หลาย core (แต่ละ process ทำงาน PDF ได้ทีละ core) แนะนำ = จำนวน core − 1
#   ไม่ตั้ง = 3 (docker-compose.prod.yml) · เครื่อง 2 core ตั้ง 2 · 8 core ตั้ง 6–7 · RAM ราว 1–2GB ต่อ process ตอนใช้งานหนัก
# BACKEND_WORKERS=3
# DB_POOL_SIZE=5            # การเชื่อมต่อฐานข้อมูลต่อ process (+ DB_MAX_OVERFLOW=10) — รวมทุก process ต้องไม่เกิน max_connections ของ PostgreSQL (100)
# คิวงานหนัก (ลดขนาดไฟล์ / PDF/A / แปลง Word / OCR) — ทำพร้อมกันได้ BACKEND_WORKERS × HEAVY_JOBS_PER_WORKER งาน ที่เหลือรอคิว
#   ไม่ให้งานหนักแย่ง CPU จนการเปิด/แก้ไขเอกสารของคนอื่นช้า · คิวต่อ process ยาวเกิน HEAVY_QUEUE_MAX หรือรอเกิน
#   HEAVY_QUEUE_TIMEOUT วินาที → แจ้งผู้ใช้ "ลองใหม่อีกครั้ง" (HTTP 503) · เครื่อง CPU เยอะตั้ง HEAVY_JOBS_PER_WORKER=2 ได้
# HEAVY_JOBS_PER_WORKER=1
# HEAVY_QUEUE_MAX=8
# HEAVY_QUEUE_TIMEOUT=120
# หน้าแอดมินเตือน + แจ้งแอดมินเมื่อไม่มีการสำรองข้อมูลเกินกี่ชั่วโมง (สคริปต์สำรองเขียนเวลาไว้ใน backend)
# BACKUP_MAX_AGE_HOURS=36

# ---------- ความปลอดภัย (จำเป็น — ไม่ตั้ง backend จะไม่ยอม start) ----------
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# ⚠ ใช้เข้ารหัส API key Gemini ที่ผู้ใช้บันทึกไว้ด้วย — เปลี่ยนแล้วทุกคนหลุด login และต้องใส่ API key ใหม่ · ห้ามเปลี่ยนหลังเปิดใช้
JWT_SECRET=<ค่าสุ่มยาวอย่างน้อย 32 ตัว>
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- ผู้ดูแลระบบ (แนะนำให้ตั้งก่อนเปิดเว็บครั้งแรก) ----------
# ไม่ตั้ง = ผู้ที่สมัครคนแรกได้สิทธิ์ผู้ดูแล · ตั้งภายหลัง: ... exec backend python -m scripts.make_admin <email>
# INITIAL_ADMIN_EMAILS=<you@your-domain.com>

# ---------- URL ของหน้าเว็บ (จำเป็น) ----------
# URL ที่ผู้ใช้เปิดจริง ใช้สร้างลิงก์ในอีเมล — ไม่มี / ปิดท้าย
FRONTEND_URL=https://<your-domain.com>
# Passkey (WebAuthn) ผูกกับโดเมนของ FRONTEND_URL อัตโนมัติ — ถ้าเปลี่ยนโดเมนภายหลัง passkey เดิมจะใช้ไม่ได้
# WEBAUTHN_RP_ID=your-domain.com          # ใช้เมื่อต้องการให้ passkey ใช้ได้ทั้งโดเมนหลักและ subdomain
# WEBAUTHN_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ---------- อีเมล (ควรตั้ง — ไม่ตั้งจะสมัคร/ยืนยันอีเมล/ลืมรหัสผ่านไม่ได้) ----------
SMTP_SERVER=smtp.gmail.com
# พอร์ต 587 = STARTTLS · 465 = SSL (ระบบเลือกให้อัตโนมัติ)
SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_SECURITY=starttls                  # starttls | ssl | none — ว่าง = เลือกจากพอร์ต (465 → ssl)
# SMTP_AUTH=true                          # ว่าง = login เมื่อตั้ง SMTP_USERNAME (relay ที่ไม่ต้อง login ตั้ง false + SMTP_FROM)
SMTP_USERNAME=<your_email@gmail.com>
# ค่าที่มีเครื่องหมาย $ ต้องครอบด้วย '...' (compose แปลง $ เป็นตัวแปร)
SMTP_PASSWORD=<app_password_16_ตัว>
# SMTP_FROM=no-reply@your-domain.com
#   ใช้ Gmail: เว้นว่าง หรือใส่อีเมลเดียวกับ SMTP_USERNAME — โดเมนอื่นต้องตั้ง DKIM ของโดเมนนั้นด้วย ไม่งั้นอาจถูกตีกลับ (550 5.7.30)
# APP_NAME=JA PDF Editor
# ลิงก์ซอร์สโค้ดที่แสดงในหน้าเว็บ (AGPL-3.0) — ไม่แก้โค้ด: ไม่ต้องตั้ง · แก้โค้ดแล้วเปิดให้คนอื่นใช้: ชี้ไปที่ซอร์สฉบับที่แก้
# SOURCE_CODE_URL=https://github.com/jaturon2526/ja-pdf-editor

# ---------- ไม่บังคับ ----------
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
#   ปุ่ม Google แสดงเมื่อตั้งค่านี้ (หน้าเว็บอ่านจาก /api/config/public — ไม่ต้อง build frontend ใหม่) · ปิดชั่วคราว: AUTH_GOOGLE_ENABLED=false
# GEMINI_API_KEY=AIza...
# ผู้ให้บริการ AI: gemini (ค่าเริ่มต้น) | anthropic (Claude) | openai (OpenAI / Azure OpenAI / vLLM / Ollama / LiteLLM)
#   Claude ต้องใช้ API key จาก Claude Console (console.anthropic.com — คิดเงินตามการใช้) แผนสมาชิก Claude Pro/Max/Team ใช้แทนไม่ได้
# AI_PROVIDER=anthropic
# AI_API_KEY='sk-ant-...'                # gemini ใช้ GEMINI_API_KEY เดิมได้
# AI_MODEL=                               # ว่าง = รุ่นเร็วของค่าย (gemini: Flash ล่าสุด, anthropic: claude-haiku-5-5) · openai ต้องระบุ
# AI_BASE_URL=                            # openai: URL ของ API เช่น https://<resource>.openai.azure.com/openai/v1 หรือ http://llm.local:8000/v1
# AI_USER_KEYS_ENABLED=true               # ผู้ใช้ใส่ API key ของตัวเอง (เลือกค่ายเอง เช่น เครดิตแผนก) — false = ใช้ AI ของระบบอย่างเดียว
# AI_PRIVATE_HOSTS=                       # โฮสต์ภายในที่ผู้ใช้ตั้งเป็น URL ของ API ได้ (คั่นด้วย ,) — ปกติห้ามชี้เข้าเครือข่ายภายใน
# AI_SYSTEM_DAILY_LIMIT=2
# ประทับเวลาลายเซ็น (RFC 3161) — production ใช้ Sectigo · ทางเลือก http://timestamp.digicert.com · ว่าง = ไม่ประทับเวลา
# SIGNING_TSA_URL=http://timestamp.sectigo.com
# ใบรับรองระบบจาก CA: วางไฟล์ไว้ที่ ./secrets/seal.p12 ข้าง docker-compose.prod.yml
# SIGNING_SEAL_P12=/run/secrets/pdf-editor/seal.p12
# SIGNING_SEAL_P12_PASSWORD=
# PDF_MAX_UPLOAD_SIZE=52428800            # เกิน 60M ต้องแก้ client_max_body_size ใน frontend/nginx.conf แล้ว build ใหม่
# PDF_SESSION_TTL_MINUTES=120             # ปิดเอกสารที่ไม่ได้ใช้หลังกี่นาที (หน้าแก้ไขส่งสัญญาณทุก 5 นาทีขณะเปิดแท็บ)
# PDF_CLEANUP_INTERVAL_MINUTES=60         # รอบเก็บกวาดไฟล์ชั่วคราว/ไฟล์ Word ที่แปลงแล้ว (เก็บ 24 ชม.)
# SIGNING_DUE_SOON_HOURS=24
# SIGNING_FETCH_CHAIN=true

# ---------- แจ้งเตือนการลงนามทาง LINE (ไม่บังคับ — ไม่ตั้ง = ปิดฟีเจอร์) ----------
# ผู้ใช้ที่เชื่อม LINE (หน้าความปลอดภัย) ได้แจ้งเตือนการลงนามทาง LINE แทนอีเมล — LINE ล้ม/โควตาครบ → อีเมลแทน
# ค่าจาก LINE Developers Console › provider › channel (Messaging API):
#   Channel secret = แท็บ Basic settings (ยาว 32) · Channel access token (long-lived) = แท็บ Messaging API › Issue
# แก้ไฟล์ด้วย nano (ไม่ใช้ echo — ค่าจะค้างใน shell history) · ตรวจโดยไม่แสดงค่า:
#   awk -F= '/^LINE_/{print $1, length($2)}' .env.prod
# หลังตั้งค่าแล้ว: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --force-recreate backend
#   ตรวจ: curl -s -X POST https://<your-domain.com>/api/line/webhook -d '{}'  → {"detail":"invalid signature"} = เปิดใช้แล้ว
# ตั้งใน console: Webhook URL = https://<your-domain.com>/api/line/webhook → Verify → เปิด Use webhook
# ตั้งใน OA Manager › ตั้งค่าการตอบกลับ: Webhook เปิด · ข้อความตอบกลับอัตโนมัติ ปิด · ข้อความทักทาย ปิด
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_OA_BASIC_ID=@xxxxxxxx
# LINE_MONTHLY_LIMIT=280                  # แพ็กเกจฟรี 300 ข้อความ/เดือน — ครบแล้วส่งอีเมลแทน

# ---------- เข้าสู่ระบบด้วย LINE (ไม่บังคับ — ไม่ตั้ง = ซ่อนปุ่ม) ----------
# LINE Developers Console › provider เดียวกับ OA (userId ตรงกัน) › สร้าง channel แบบ LINE Login (Web app)
#   Channel ID / Channel secret = แท็บ Basic settings · Callback URL (แท็บ LINE Login) = https://<your-domain.com>/auth/line/callback
#   Basic settings › Linked LINE Official Account = OA ของเรา (ปุ่มเพิ่มเพื่อนในหน้าอนุญาต) · OpenID Connect › Email address permission = Apply
#   ต้อง Publish channel (Developing = เข้าได้เฉพาะ admin/tester ของ channel)
# ตรวจโดยไม่แสดงค่า: awk -F= '/^LINE_LOGIN_/{print $1, length($2)}' .env.prod  → ID ยาว 10, secret ยาว 32
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=
# AUTH_LINE_ENABLED=true                  # false = ปิดทั้งเข้าสู่ระบบและแจ้งเตือนทาง LINE โดยไม่ต้องลบค่าด้านบน

# ตั้งไว้ใน docker-compose.prod.yml แล้ว: DATABASE_URL, PDF_REDIS_URL, APP_ENV=production, APP_TIMEZONE, TZ

# ---------- หน้าโควต้า/เครดิตของแอดมิน (ไม่บังคับ) ----------
# Brevo API key แบบ Restricted: Transactional email = Read, Account = Read (ปิด MCP) — Settings › SMTP & API › API Keys
#   ไม่ตั้ง = นับจำนวนอีเมลเองในระบบ · key หมดอายุถ้าไม่ถูกใช้ 90 วัน (ระบบเรียกทุก QUOTA_CHECK_INTERVAL_MINUTES จึงไม่หมด)
# BREVO_API_KEY=
# BREVO_DAILY_LIMIT=300                   # แพ็กเกจฟรี 300 ฉบับ/วัน
# AI_DAILY_REQUEST_LIMIT=0                # เพดานคำขอ AI/วันของ key ระบบ (เดิม GEMINI_DAILY_REQUEST_LIMIT) — 0 = ไม่ทราบ แสดงแค่จำนวนที่ใช้
# QUOTA_ALERT_PERCENT=80                  # แจ้งแอดมิน (LINE ถ้าผูกไว้ ไม่งั้นอีเมล) เมื่อใช้เกิน % นี้ — วันละไม่เกิน 1 ครั้งต่อบริการ
# QUOTA_CHECK_INTERVAL_MINUTES=60
