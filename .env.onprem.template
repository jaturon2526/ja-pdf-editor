# =============================================================================
# .env.prod สำหรับ "ติดตั้งในองค์กร" (on-premise) — ใช้กับ docker-compose.prod.yml เหมือนเว็บสาธารณะ
#   cp .env.onprem.template .env.prod      แล้วแก้ค่าที่มี <...>
# ติดตั้งได้ 2 แบบ:
#   ก) ใช้ image จาก Docker Hub ที่ build ด้วย scripts/onprem/build-push.sh (เซิร์ฟเวอร์ไม่ต้องมีซอร์สโค้ด)
#      → ./deploy.sh setup แล้ว ./deploy.sh deploy (deploy.sh อยู่ในชุดไฟล์ dist/onprem-deploy-kit.tar.gz)
#   ข) build บนเซิร์ฟเวอร์เองจาก git clone:
#      docker compose --env-file .env.prod -f docker-compose.prod.yml -f docker-compose.onprem-build.yml \
#        -f docker-compose.onprem-tls.yml up -d --build
#   (onprem-tls: ไม่ใช้ถ้าองค์กรมี reverse proxy ที่ทำ HTTPS ให้อยู่แล้ว — ดูหัวข้อ HTTPS)
# ขั้นตอนทั้งหมด: README.md หัวข้อ "ติดตั้งในองค์กร (On-premise)"
# ห้าม commit ไฟล์ .env.prod (อยู่ใน .gitignore แล้ว)
#
# รูปแบบนี้: สมัคร/เข้าสู่ระบบด้วยอีเมลขององค์กร + รหัสผ่าน และ passkey · ไม่มีปุ่ม Google / LINE
#   ส่งอีเมลจาก mail server ขององค์กร · ลงนามเอกสารด้วยใบรับรองขององค์กร · เซิร์ฟเวอร์ออก internet ได้
#   (ซอร์สโค้ดเดียวกับเว็บสาธารณะ — ต่างกันแค่ค่าในไฟล์นี้)
#
# ครั้งแรก: backend สร้างตารางในฐานข้อมูลทั้งหมดเองตอน start (Alembic) และอัปเกรด schema เองทุกครั้งที่ deploy
# สำรองข้อมูล = ฐานข้อมูล (volume pgdata_prod) + ไฟล์ผู้ใช้ (volume pdf_data_prod) + .env.prod + ./secrets — ต้องครบทั้ง 4
# ตรวจค่าหลัง start:  docker logs pdf_backend_prod 2>&1 | grep "รูปแบบการติดตั้ง"
#   → รูปแบบการติดตั้ง: onprem · Google: ปิด · LINE: ปิด · สมัครเอง: ได้ · โดเมน: <โดเมนองค์กร> · SMTP: ...
# =============================================================================

# ---------- รูปแบบการติดตั้ง (จำเป็น) ----------
# onprem = ปิดการเข้าสู่ระบบด้วย Google / LINE และการแจ้งเตือนทาง LINE (แม้มีค่า GOOGLE_*/LINE_* ค้างอยู่)
DEPLOYMENT_PROFILE=onprem
APP_NAME=<ชื่อระบบ เช่น ระบบเอกสาร PDF บริษัท ABC>
# ลิงก์ซอร์สโค้ดที่แสดงในหน้าเว็บ (AGPL-3.0) — ไม่แก้โค้ด: ไม่ต้องตั้ง · แก้โค้ดแล้วเปิดให้คนอื่นใช้: ชี้ไปที่ซอร์สฉบับที่แก้
# SOURCE_CODE_URL=https://github.com/jaturon2526/ja-pdf-editor

# ---------- image (แบบ ก — Docker Hub) ----------
# แท็กแยกจากเว็บสาธารณะ: onprem = ล่าสุดเสมอ · onprem-v1.26.18-ab12cd3 = ตรึงเวอร์ชัน (แนะนำ — rollback ได้)
# ./deploy.sh deploy <แท็ก> แก้ค่า IMAGE_TAG ให้เอง · repository เป็น private: docker login บนเซิร์ฟเวอร์ก่อน
#   (แบบ ข build บนเครื่อง ไม่ใช้ 3 ค่านี้)
IMAGE_TAG=onprem
BACKEND_IMAGE=docker.io/jaturon2526/pdf-editor-backend
FRONTEND_IMAGE=docker.io/jaturon2526/pdf-editor-frontend

# ---------- ใครสมัครได้ ----------
# บัญชีใหม่ต้องใช้อีเมลโดเมนเหล่านี้ (คั่นด้วย , ไม่ต้องมี @) — ว่าง = ทุกโดเมน
#   ยกเว้น: ผู้ที่ได้รับคำเชิญลงนามเอกสาร สมัครด้วยอีเมลที่ถูกเชิญได้แม้อยู่นอกโดเมน (เช่น คู่ค้าที่ต้องลงนาม)
ALLOWED_EMAIL_DOMAINS=<your-company.co.th>
# false = ไม่มีปุ่ม "สมัครสมาชิกใหม่" — สมัครได้เฉพาะ INITIAL_ADMIN_EMAILS (ที่ /login?register=1) และผู้ได้รับคำเชิญลงนาม
#   (ยังไม่มีหน้าให้ผู้ดูแลสร้างบัญชีให้ผู้อื่น — ถ้าพนักงานต้องสมัครเอง ให้คงไว้ true แล้วจำกัดด้วย ALLOWED_EMAIL_DOMAINS)
ALLOW_SELF_REGISTRATION=true

# พื้นที่เก็บไฟล์ต่อคน (MB) ของแพ็กเกจเริ่มต้น — มีผลตอนติดตั้งครั้งแรก ติดตั้งแล้วเปลี่ยนที่หน้าผู้ดูแล › แพ็กเกจ
#   วางแผนดิสก์: ผู้ใช้ × โควต้า × ~0.4 (ใช้จริงเฉลี่ย) + backup — เช่น 1,000 คน × 200MB ≈ 80GB + backup
DEFAULT_STORAGE_MB=200

# ---------- ผู้ดูแลระบบ (จำเป็นสำหรับ onprem) ----------
# บัญชีเหล่านี้ได้สิทธิ์ผู้ดูแลเมื่อสมัครครั้งแรก (คั่นด้วย ,) — ตั้งภายหลัง: docker exec pdf_backend_prod python -m scripts.make_admin <email>
INITIAL_ADMIN_EMAILS=<it-admin@your-company.co.th>

# ---------- ฐานข้อมูล (จำเป็น) ----------
DB_USER=pdf_user
# ⚠ postgres ตั้งรหัสผ่านจากค่านี้ "ครั้งแรกที่สร้าง volume" เท่านั้น — แก้ทีหลังต้อง ALTER USER pdf_user PASSWORD '...' ด้วย
DB_PASSWORD=<รหัสผ่านฐานข้อมูลที่เดายาก>
DB_NAME=pdf_editor
# REDIS_MAXMEMORY=1536mb
# จำนวน process ของ backend — ใช้ CPU หลาย core (แต่ละ process ทำงาน PDF ได้ทีละ core) แนะนำ = จำนวน core − 1
#   ไม่ตั้ง = 3 (docker-compose.prod.yml) · เครื่อง 2 core ตั้ง 2 · 8 core ตั้ง 6–7 · RAM ราว 1–2GB ต่อ process ตอนใช้งานหนัก
# BACKEND_WORKERS=3
# DB_POOL_SIZE=5            # การเชื่อมต่อฐานข้อมูลต่อ process (+ DB_MAX_OVERFLOW=10) — รวมทุก process ต้องไม่เกิน max_connections ของ PostgreSQL (100)
# คิวงานหนัก (ลดขนาดไฟล์ / PDF/A / แปลง Word / OCR) — ทำพร้อมกันได้ BACKEND_WORKERS × HEAVY_JOBS_PER_WORKER งาน ที่เหลือรอคิว
#   ไม่ให้งานหนักแย่ง CPU จนการเปิด/แก้ไขเอกสารของคนอื่นช้า · คิวต่อ process ยาวเกิน HEAVY_QUEUE_MAX หรือรอเกิน
#   HEAVY_QUEUE_TIMEOUT วินาที → แจ้งผู้ใช้ "ลองใหม่อีกครั้ง" (HTTP 503) · เครื่อง CPU เยอะตั้ง HEAVY_JOBS_PER_WORKER=2 ได้
# HEAVY_JOBS_PER_WORKER=1
# HEAVY_QUEUE_MAX=8
# HEAVY_QUEUE_TIMEOUT=120
# หน้าแอดมินเตือน + แจ้งแอดมินเมื่อไม่มีการสำรองข้อมูลเกินกี่ชั่วโมง (สคริปต์สำรองเขียนเวลาไว้ใน backend)
# BACKUP_MAX_AGE_HOURS=36

# ---------- ความปลอดภัย (จำเป็น — ไม่ตั้ง backend จะไม่ยอม start) ----------
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# ⚠ ห้ามเปลี่ยนหลังเปิดใช้ (ทุกคนหลุด login และ API key Gemini ที่ผู้ใช้บันทึกไว้จะใช้ไม่ได้)
JWT_SECRET=<ค่าสุ่มยาวอย่างน้อย 32 ตัว>
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- URL ของหน้าเว็บ + HTTPS (จำเป็น) ----------
# URL ที่พนักงานเปิดจริง (ใช้สร้างลิงก์ในอีเมล) — ต้องเป็น https ไม่มี / ปิดท้าย
#   เปิดให้เข้าจาก internet: ใช้โดเมนสาธารณะ + ใบรับรอง TLS จาก CA สาธารณะ (ใบจาก CA ภายในใช้ได้เฉพาะเครื่องขององค์กร)
FRONTEND_URL=https://<pdf.your-company.co.th>
# HTTPS มี 2 ทาง:
#   1) ใช้ใบรับรอง TLS ขององค์กรกับเครื่องนี้โดยตรง: วาง ./secrets/tls/fullchain.pem + privkey.pem
#      แล้วรันพร้อม -f docker-compose.onprem-tls.yml (รายละเอียดในไฟล์นั้น) — deploy.sh ทำให้เองเมื่อมีไฟล์ใบรับรอง
#      สั่ง docker compose เอง: ใส่ FRONTEND_BIND=127.0.0.1:8081 ด้วย (ย้ายหน้าเว็บออกจากพอร์ต 80 ให้ nginx tls)
#   2) reverse proxy / load balancer ขององค์กรทำ HTTPS แล้วส่งต่อมาที่ http://<เครื่องนี้>:80 — ไม่ต้องใช้ไฟล์ข้างต้น
#      (ตั้ง client_max_body_size ≥ 60M และ timeout ≥ 120 วินาทีที่ proxy ด้วย)
# ONPREM_TLS=false                      # deploy.sh: บังคับไม่ใช้ HTTPS ในตัว (true = บังคับใช้)
# FRONTEND_BIND=80                      # พอร์ตหน้าเว็บ (ไม่ใช้ HTTPS ในตัว) เช่น 8080 — Podman ไม่ใช้ root เปิดพอร์ต < 1024 ไม่ได้
#                                       #   ถ้าเปลี่ยน ใส่พอร์ตใน FRONTEND_URL ด้วย เช่น http://192.168.1.50:8080
#
# Passkey ผูกกับโดเมนของ FRONTEND_URL อัตโนมัติ (ต้องเป็น https) — เปลี่ยนโดเมนภายหลัง passkey เดิมจะใช้ไม่ได้
# WEBAUTHN_RP_ID=your-company.co.th     # ให้ passkey ใช้ได้ทั้งโดเมนหลักและ subdomain
# WEBAUTHN_RP_NAME=ระบบเอกสาร PDF       # ชื่อที่แสดงในหน้าต่างสร้าง passkey

# ---------- อีเมลจาก mail server ขององค์กร (จำเป็น — ใช้ยืนยันอีเมล ลืมรหัสผ่าน และแจ้งเตือนการลงนาม) ----------
# ที่อยู่ผู้ส่ง: อีเมลของโดเมนองค์กร (mail server ต้องอนุญาตให้ส่งในชื่อนี้)
SMTP_FROM=<pdf-noreply@your-company.co.th>
SMTP_SERVER=<mail.your-company.co.th>
# เลือก 1 แบบ แล้วลบ # ออก:
#   ก) relay ภายใน อนุญาตตาม IP ไม่ต้อง login (พอร์ต 25) — ให้ IT เพิ่ม IP ของเครื่องนี้ใน relay allow list
# SMTP_PORT=25
# SMTP_SECURITY=none
# SMTP_AUTH=false
#   ข) Exchange / Microsoft 365 / mail server ที่ต้อง login ด้วยบัญชีบริการ (พอร์ต 587 STARTTLS)
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_AUTH=true
# SMTP_USERNAME=<svc-pdf@your-company.co.th>
# SMTP_PASSWORD='<รหัสผ่านบัญชีบริการ>'    # ครอบด้วย '...' เสมอ — รหัสผ่านที่มี $ ไม่งั้นถูกตัด (login ไม่ผ่าน 535)
#   ค) SMTP over SSL (พอร์ต 465)
# SMTP_PORT=465
# SMTP_SECURITY=ssl
#
# mail server ใช้ใบรับรองที่ออกโดย CA ขององค์กร (starttls/ssl): วางไฟล์ CA (PEM) ไว้ที่ ./secrets/org-ca.pem
# SMTP_CA_FILE=/run/secrets/pdf-editor/org-ca.pem

# ---------- ลงนามเอกสารด้วยใบรับรองขององค์กร ----------
# ใบรับรองระบบ (ใช้ประทับตราเอกสารที่ลงนามผ่านระบบ และหนังสือรับรองการลงนาม) — แทนใบรับรอง self-signed ของระบบ
# ไฟล์ .p12/.pfx ที่มี private key + ใบรับรอง (+ chain ถ้ามี) — ขอจาก IT/CA ขององค์กร ให้มี key usage แบบ digitalSignature
#   วางไว้ที่ ./secrets/seal.p12 ข้าง docker-compose.prod.yml (chmod 600) · path ด้านล่างคือ path "ใน container"
# SIGNING_SEAL_P12=/run/secrets/pdf-editor/seal.p12
# SIGNING_SEAL_P12_PASSWORD=<รหัสผ่านไฟล์ p12>
# ตรวจหลัง start: docker logs pdf_backend_prod 2>&1 | grep -i "ใบรับรองระบบ"
#
# ดาวน์โหลด intermediate/root ตาม URL ในใบรับรอง เมื่อไฟล์ .p12 ไม่ได้รวม chain มา (ต้องออก internet/เข้าถึง URL ของ CA ได้)
# SIGNING_FETCH_CHAIN=true
# ประทับเวลาลายเซ็น (RFC 3161) — ช่วยให้ลายเซ็นยังตรวจได้หลังใบรับรองหมดอายุ · ว่าง = ไม่ประทับเวลา
#   ใช้ TSA ขององค์กรได้ถ้ามี · ถ้า TSA ติดต่อไม่ได้ ระบบลงนามต่อโดยไม่มี timestamp
# SIGNING_TSA_URL=http://timestamp.sectigo.com
#
# หมายเหตุ: Adobe Reader แสดงลายเซ็นว่า "ถูกต้อง" เมื่อเครื่องนั้นเชื่อถือ CA ของใบรับรอง — CA ภายในองค์กร
#   ต้องติดตั้งเป็น trusted root ในเครื่องพนักงาน (หรือเพิ่มใน Adobe › Trusted Certificates) · คนนอกองค์กรจะเห็น "ไม่ทราบผู้ออก"
# ผู้ลงนามแต่ละคนยังอัปโหลดใบรับรองส่วนตัว (.p12) ของตัวเองตอนลงนามแบบดิจิทัลได้ตามปกติ

# ---------- AI (ไม่บังคับ) ----------
# ⚠ เนื้อหาเอกสารที่ใช้ฟีเจอร์ AI (แปลง PDF→Word แบบ AI, OCR) ถูกส่งไปประมวลผลที่ผู้ให้บริการที่ตั้ง — ตรวจนโยบายข้อมูลขององค์กรก่อน
#   โมเดลที่รันในองค์กร (AI_PROVIDER=openai + AI_BASE_URL ภายใน) ข้อมูลไม่ออกนอกเครือข่าย
#   ไม่ตั้ง = ไม่มี AI ส่วนกลาง: ไม่แสดงกล่องโควต้า AI และซ่อนตัวเลือก AI (ผู้ใช้ยังใส่ API key ของตัวเองได้ในหน้า AI)
#   ปิด AI ทั้งหมด (ซ่อนเมนูตั้งค่า AI ด้วย) = ไม่ตั้ง key ของระบบ + AI_USER_KEYS_ENABLED=false
# ผู้ให้บริการ AI: gemini (ค่าเริ่มต้น) | anthropic (Claude) | openai (OpenAI / Azure OpenAI / vLLM / Ollama / LiteLLM)
#   Claude ต้องใช้ API key จาก Claude Console (console.anthropic.com — คิดเงินตามการใช้) แผนสมาชิก Claude Pro/Max/Team ใช้แทนไม่ได้
# AI_PROVIDER=anthropic
# AI_API_KEY='sk-ant-...'                # gemini ใช้ GEMINI_API_KEY เดิมได้
# AI_MODEL=                               # ว่าง = รุ่นเร็วของค่าย (gemini: Flash ล่าสุด, anthropic: claude-haiku-5-5) · openai ต้องระบุ
# AI_BASE_URL=                            # openai: URL ของ API เช่น https://<resource>.openai.azure.com/openai/v1 หรือ http://llm.local:8000/v1
# AI_USER_KEYS_ENABLED=true               # ผู้ใช้ใส่ API key ของตัวเอง (เลือกค่ายเอง เช่น เครดิตแผนก) — false = ใช้ AI ของระบบอย่างเดียว
# AI_PRIVATE_HOSTS=                       # โฮสต์ภายในที่ผู้ใช้ตั้งเป็น URL ของ API ได้ (คั่นด้วย ,) — ปกติห้ามชี้เข้าเครือข่ายภายใน
# GEMINI_API_KEY=AIza...
# AI_SYSTEM_DAILY_LIMIT=2                 # ครั้งที่แปลงด้วย AI ของระบบได้ต่อผู้ใช้ต่อวัน

# ---------- ไม่บังคับ ----------
# PDF_MAX_UPLOAD_SIZE=52428800            # เกิน 60M ต้องแก้ client_max_body_size ใน frontend/nginx.conf (+ nginx-tls.conf) แล้ว build ใหม่
# PDF_SESSION_TTL_MINUTES=120             # ปิดเอกสารที่ไม่ได้ใช้หลังกี่นาที (หน้าแก้ไขส่งสัญญาณทุก 5 นาทีขณะเปิดแท็บ)
# PDF_CLEANUP_INTERVAL_MINUTES=60
# SIGNING_DUE_SOON_HOURS=24
# FONT_URL_ALLOWED_HOSTS=fonts.google.com,fonts.googleapis.com   # "ติดตั้งฟอนต์จากลิงก์" (https เท่านั้น)

# ---------- LINE ขององค์กร (ไม่บังคับ — ปิดเป็นค่าเริ่มต้นใน onprem) ----------
# ใช้ได้กับอีเมลองค์กร: บัญชีจับคู่ด้วยอีเมล และ ALLOWED_EMAIL_DOMAINS / ALLOW_SELF_REGISTRATION ใช้กับบัญชีใหม่จาก LINE ด้วย
# พนักงานที่อีเมล LINE เป็นอีเมลส่วนตัว: เข้าด้วยอีเมลองค์กรก่อน → หน้าความปลอดภัย → ผูก LINE → ครั้งต่อไปกด "เข้าสู่ระบบด้วย LINE" ได้
# ต้องมี: FRONTEND_URL=https://<โดเมน> · เซิร์ฟเวอร์ออกอินเทอร์เน็ตไป api.line.me ได้ · แจ้งเตือน: LINE ต้องเรียก Webhook จากอินเทอร์เน็ตได้
# ขั้นตอน (LINE Developers Console — developers.line.biz) ทำทั้ง 2 channel ใต้ "provider เดียวกัน" (userId ของพนักงานจึงตรงกัน
#   → เข้าสู่ระบบด้วย LINE ครั้งแรกแล้วระบบผูกรับแจ้งเตือนให้เอง ถ้าเพิ่มเพื่อน OA แล้ว):
#   1) สร้าง LINE Official Account ขององค์กร (manager.line.biz) แล้วเปิด Messaging API เลือก provider ขององค์กร
#      → channel แบบ Messaging API: Channel secret (แท็บ Basic settings) + Channel access token long-lived (แท็บ Messaging API › Issue)
#      → Webhook URL = https://<โดเมน>/api/line/webhook → Verify → เปิด Use webhook
#      → OA Manager › ตั้งค่าการตอบกลับ: Webhook เปิด · ข้อความตอบกลับอัตโนมัติ ปิด · ข้อความทักทาย ปิด
#   2) provider เดียวกัน › Create a new channel › LINE Login (Web app)
#      → Channel ID / Channel secret (แท็บ Basic settings) · Callback URL (แท็บ LINE Login) = https://<โดเมน>/auth/line/callback
#      → Basic settings › Linked LINE Official Account = OA จากข้อ 1 · OpenID Connect › Email address permission = Apply
#      → เปลี่ยนสถานะ channel เป็น Published (Developing = เข้าได้เฉพาะผู้ที่เพิ่มเป็น tester)
#   3) ใส่ค่าด้านล่าง (แก้ด้วย nano ไม่ใช้ echo) แล้ว ./deploy.sh setup (ตรวจความยาวค่า + แสดง URL ที่ต้องลงทะเบียน) → ./deploy.sh deploy
#   ตรวจ: curl -s -X POST https://<โดเมน>/api/line/webhook -d '{}' → {"detail":"invalid signature"} = แจ้งเตือนพร้อมใช้
#         curl -s https://<โดเมน>/api/config/public → "line_login": true
# AUTH_LINE_ENABLED=true
# LINE_LOGIN_CHANNEL_ID=                  # ตัวเลข 10 หลัก
# LINE_LOGIN_CHANNEL_SECRET=              # 32 ตัวอักษร
# LINE_CHANNEL_SECRET=                    # 32 ตัวอักษร (channel Messaging API)
# LINE_CHANNEL_ACCESS_TOKEN=              # long-lived token (ยาว ~170 ตัวอักษร)
# LINE_OA_BASIC_ID=@xxxxxxxx              # ID ของ OA (แสดงปุ่ม/QR เพิ่มเพื่อนในหน้าความปลอดภัย)
# LINE_MONTHLY_LIMIT=280                  # แพ็กเกจฟรีของ OA ส่งได้ 300 ข้อความ/เดือน — ครบแล้วส่งอีเมลแทน (แพ็กเกจที่ซื้อ: ปรับตาม)

# ---------- Google (ปิดไว้สำหรับ onprem) ----------
# เปิดเมื่ออีเมลองค์กรอยู่บน Google Workspace เท่านั้น (ไม่งั้นพนักงานได้ Gmail ส่วนตัวซึ่งไม่ตรงกับบัญชีองค์กร)
#   AUTH_GOOGLE_ENABLED=true + GOOGLE_CLIENT_ID ตาม .env.prod.template · Authorized JavaScript origins = https://<โดเมน> (ใช้ IP ไม่ได้)
# AUTH_GOOGLE_ENABLED=false

